{
  "manifest_version": 3,
  "name": "Simple Video Speed",
  "version": "1.0.0",
  "description": "Simple keyboard controls for HTML5 video playback speed.",

  "browser_specific_settings": {
    "gecko": {
      "id": "simple-video-speed@jalves.dev.br",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true
    }
  ]
}
